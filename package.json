{
  "name": "@webdevsk/array-tree",
  "version": "1.0.0-beta.1",
  "description": "Represents a tree structure as a flat array.",
  "license": "MIT",
  "author": "Sergey Konstantinov",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/Web-Dev-SK/array-tree",
  "repository": {
    "type": "git",
    "url": "https://github.com/Web-Dev-SK/array-tree.git"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "test": "vitest run",
    "prepublishOnly": "npm run check && npm test"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
